/* Main window */
QWidget {
    background-color: #1a1a1a;
    color: #6dab74;
}

/* Progress bar */
QProgressBar {
    background-color: #2a2a2a;
    border: 1px solid #6dab74;
    border-radius: 4px;
    text-align: center;
    color: #ffffff;
}

QProgressBar::chunk {
    background-color: #6dab74;
    border-radius: 4px;
}

/* Buttons */
QPushButton {
    background-color: #2a2a2a;
    color: #6dab74;
    border: 1px solid #6dab74;
    border-radius: 4px;
    padding: 6px 16px;
}

QPushButton:hover {
    background-color: #6dab74;
    color: #000000;
}

QPushButton:pressed {
    background-color: #3d5c40;
}

/* Input fields */
QLineEdit, QComboBox {
    background-color: #2a2a2a;
    color: #ffffff;
    border: 1px solid #6dab74;
    border-radius: 4px;
    padding: 4px;
}

/* Labels */
QLabel {
    color: #ffffff;
}

/* Sidebar */
#sidebarApp {
    background-color: #1a1a1a;
    color: #cc3333;
}

#sidebarMenuApp {
    background-color: #1a1a1a;
    color: #cc3333;
}

QListView {
    background-color: #1a1a1a;
    color: #cc3333;
}

QListView::item {
    color: #cc3333;
}

QListView::item:selected {
    background-color: #1a1a1a;
    color: #cc3333;
}

#sidebarApp {
    background-color: #4a4a4a !important;
    color: #ffffff !important;
}

#logoApp {
    background-color: #4a4a4a !important;
}
