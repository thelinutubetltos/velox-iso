[Trigger]
Type = Package
Operation = Install
Operation = Upgrade
Target = ksmoothdock

[Action]
Description = Force XWayland mode for ksmoothdock (fixes dock positioning on Plasma Wayland)
When = PostTransaction
Exec = /bin/sed -i s|^Exec=ksmoothdock|Exec=env QT_QPA_PLATFORM=xcb ksmoothdock| /usr/share/applications/ksd.ksmoothdock.desktop
