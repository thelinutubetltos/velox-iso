#!/usr/bin/env python3
# velox-set-resolution — first-run resolution wizard using PyQt6.
# Runs once per user; marks itself done via a flag file.

import os
import re
import subprocess
import sys
import time
from pathlib import Path

done_flag = Path(os.environ.get("HOME", "/root")) / ".config/velox-resolution-configured"
if done_flag.exists():
    sys.exit(0)

time.sleep(5)  # wait for KDE display stack to be ready

done_flag.parent.mkdir(parents=True, exist_ok=True)

try:
    from PyQt6.QtWidgets import QApplication, QDialog, QVBoxLayout, QHBoxLayout, QLabel, QPushButton
    from PyQt6.QtCore import Qt
    from PyQt6.QtGui import QFont
except ImportError:
    done_flag.touch()
    sys.exit(0)


def strip_ansi(text):
    return re.sub(r'\x1b\[[0-9;]*m', '', text)


def get_best_res_wayland():
    try:
        raw = subprocess.check_output(['kscreen-doctor', '-o'], stderr=subprocess.DEVNULL, text=True)
    except Exception:
        return None, None, None
    info = strip_ansi(raw)

    output = None
    for line in info.splitlines():
        if 'Output:' in line:
            parts = line.split()
            idx = parts.index('Output:') if 'Output:' in parts else -1
            if idx >= 0 and idx + 2 < len(parts):
                output = parts[idx + 2]
        if output and 'connected' in line:
            break
    if not output:
        return None, None, None

    modes = re.findall(r'(\d+):(\d+x\d+)@[\d.]+', info)
    if not modes:
        return None, None, None

    best_index, best_res, best_px = None, None, 0
    for idx, res in modes:
        if res == '1920x1080':
            best_index, best_res = idx, res
            break
        w, h = map(int, res.split('x'))
        if w * h > best_px:
            best_px, best_index, best_res = w * h, idx, res

    return output, best_index, best_res


def get_best_res_x11():
    try:
        raw = subprocess.check_output(['xrandr', '--query'], stderr=subprocess.DEVNULL, text=True)
    except Exception:
        return None, None

    output = None
    for line in raw.splitlines():
        if ' connected' in line:
            output = line.split()[0]
            break
    if not output:
        return None, None

    best_res, best_px = None, 0
    in_output = False
    for line in raw.splitlines():
        if line.startswith(output):
            in_output = True
            continue
        if in_output:
            if line and not line[0].isspace():
                break
            m = re.match(r'\s+(\d+x\d+)', line)
            if m:
                res = m.group(1)
                if res == '1920x1080':
                    best_res = res
                    break
                w, h = map(int, res.split('x'))
                if w * h > best_px:
                    best_px, best_res = w * h, res

    return output, best_res


def apply_resolution(output, index_or_res, wayland):
    if wayland:
        subprocess.run(['kscreen-doctor', f'output.{output}.mode.{index_or_res}'],
                       stderr=subprocess.DEVNULL)
    else:
        subprocess.run(['xrandr', '--output', output, '--mode', index_or_res],
                       stderr=subprocess.DEVNULL)


def main():
    wayland = bool(os.environ.get('WAYLAND_DISPLAY'))

    if wayland:
        output, index, best_res = get_best_res_wayland()
    else:
        output, best_res = get_best_res_x11()
        index = best_res

    if not best_res:
        done_flag.touch()
        return

    app = QApplication(sys.argv)
    app.setApplicationName('Velox Display Setup')

    dlg = QDialog()
    dlg.setWindowTitle('Velox Linux — Display Setup')
    dlg.setWindowFlags(dlg.windowFlags() | Qt.WindowType.WindowStaysOnTopHint)
    dlg.setMinimumWidth(400)

    layout = QVBoxLayout(dlg)
    layout.setSpacing(16)
    layout.setContentsMargins(24, 24, 24, 20)

    title = QLabel('Display Setup')
    f = QFont()
    f.setPointSize(14)
    f.setBold(True)
    title.setFont(f)
    layout.addWidget(title)

    layout.addWidget(QLabel('Best available resolution for your display:'))

    res_label = QLabel(best_res)
    f2 = QFont()
    f2.setPointSize(20)
    f2.setBold(True)
    res_label.setFont(f2)
    res_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
    layout.addWidget(res_label)

    layout.addWidget(QLabel('Would you like to apply this resolution now?'))

    btns = QHBoxLayout()
    keep = QPushButton('Keep current')
    apply_btn = QPushButton(f'Apply {best_res}')
    apply_btn.setDefault(True)
    btns.addWidget(keep)
    btns.addWidget(apply_btn)
    layout.addLayout(btns)

    keep.clicked.connect(dlg.reject)
    apply_btn.clicked.connect(dlg.accept)

    if dlg.exec() == QDialog.DialogCode.Accepted:
        apply_resolution(output, index, wayland)

    done_flag.touch()


main()
