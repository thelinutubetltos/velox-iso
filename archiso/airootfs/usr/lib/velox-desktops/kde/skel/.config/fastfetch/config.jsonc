{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
        "type": "file",
        "source": "/usr/share/velox/fastfetch-logo.txt",
        "color": {
            "1": "38;2;138;184;122",
            "2": "38;2;100;148;89"
        },
        "padding": {
            "right": 3,
            "top": 1
        }
    },

    "display": {
        "separator": "  ",
        "color": {
            "keys": "38;2;138;184;122",
            "title": "38;2;138;184;122"
        }
    },

    "modules": [
        {
            "type": "title",
            "color": {
                "user": "38;2;138;184;122",
                "at": "38;2;224;224;224",
                "host": "38;2;224;224;224"
            }
        },
        {
            "type": "separator",
            "string": "─"
        },
        { "type": "os",       "key": "OS"        },
        { "type": "kernel",   "key": "Kernel"    },
        { "type": "uptime",   "key": "Uptime"    },
        { "type": "packages", "key": "Packages"  },
        { "type": "shell",    "key": "Shell"     },
        { "type": "display",  "key": "Resolution"},
        { "type": "de",       "key": "DE"        },
        { "type": "wm",       "key": "WM"        },
        { "type": "terminal", "key": "Terminal"  },
        { "type": "cpu",      "key": "CPU"       },
        { "type": "gpu",      "key": "GPU"       },
        { "type": "memory",   "key": "Memory"    },
        { "type": "disk",     "key": "Disk", "folders": "/" },
        {
            "type": "separator",
            "string": "─"
        },
        "colors"
    ]
}
