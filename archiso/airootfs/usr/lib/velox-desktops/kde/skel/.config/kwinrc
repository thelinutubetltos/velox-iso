[org.kde.kdecoration2]
library=org.kde.kwin.aurorae
theme=__aurorae__svg__leaf-dark

[Compositing]
Backend=OpenGL
GLCore=true
Enabled=true
HiddenPreviews=5
LatencyPolicy=Medium
OpenGLIsUnsafe=false

[Plugins]
blurEnabled=true
contrastEnabled=true
kwin4_effect_dialogparentEnabled=true
kwin4_effect_dimscreenEnabled=true
kwin4_effect_fadeEnabled=true
kwin4_effect_loginEnabled=true
kwin4_effect_logoutEnabled=true
kwin4_effect_maximizeEnabled=true
kwin4_effect_morphingpopupsEnabled=true
kwin4_effect_squashEnabled=true
kwin4_effect_slidingpopupsEnabled=true
magiclampEnabled=false
overviewEnabled=true
slideEnabled=true
wobblywindowsEnabled=true
zoomEnabled=true

[Effect-blur]
BlurStrength=7
NoiseStrength=0

[Effect-wobblywindows]
Drag=85
Stiffness=10
WobblynessLevel=3

[Effect-overview]
BorderActivate=9

[TabBox]
DesktopLayout=thumbnails
DesktopMode=1
HighlightWindows=true
LayoutName=thumbnail_grid

[Windows]
BorderlessMaximizedWindows=true
