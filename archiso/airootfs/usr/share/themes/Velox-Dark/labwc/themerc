# Velox Dark — labwc theme
# Dark bg #1c1c1c, Velox green #8ab87a accents

# Window dimensions
border.width: 1
padding.width: 6
padding.height: 4
window.handle.width: 0
window.button.width: 16
window.button.height: 16
window.button.spacing: 4
window.button.hover.bg.corner-radius: 4
window.titlebar.padding.height: 4
window.titlebar.padding.width: 6

# Active window
window.active.border.color: #8ab87a
window.active.title.bg: flat solid
window.active.title.bg.color: #1a2818
window.active.label.text.color: #e0e0e0
window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #1a2818
window.active.button.unpressed.image.color: #8ab87a
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #243a20
window.active.button.hover.image.color: #ffffff
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #6a9459
window.active.button.pressed.image.color: #ffffff

# Inactive window
window.inactive.border.color: #2e2e2e
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #1e1e1e
window.inactive.label.text.color: #555555
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #1e1e1e
window.inactive.button.unpressed.image.color: #404040

# Menu
menu.border.color: #4a7a3a
menu.border.width: 1
menu.overlap.x: 0
menu.overlap.y: 0
menu.items.bg.color: #1c1c1c
menu.items.text.color: #d0d0d0
menu.items.disabled.text.color: #555555
menu.items.padding.x: 16
menu.items.padding.y: 7
menu.items.active.bg.color: #243a20
menu.items.active.text.color: #ffffff
menu.title.bg.color: #161c15
menu.title.text.color: #8ab87a
menu.separator.color: #2e2e2e
menu.separator.width: 1
menu.separator.padding.width: 0
menu.separator.padding.height: 3

# OSD (alt-tab switcher)
osd.bg.color: #1c1c1c
osd.border.color: #4a7a3a
osd.border.width: 1
osd.label.text.color: #8ab87a
