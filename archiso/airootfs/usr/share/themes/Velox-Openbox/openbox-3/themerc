# Velox Openbox Theme
# Active window title bar — dark background with Velox green accents

# Fonts
window.active.label.text.font: sans:size=10:bold
window.inactive.label.text.font: sans:size=10

# Active window titlebar
window.active.title.bg: flat solid
window.active.title.bg.color: #1e1e1e
window.active.label.bg: flat solid
window.active.label.bg.color: #1e1e1e
window.active.label.text.color: #6dab74

# Active window handle (resize grip) and border
window.active.handle.bg: flat solid
window.active.handle.bg.color: #6dab74
window.active.grip.bg: flat solid
window.active.grip.bg.color: #6dab74
window.active.border.color: #6dab74
window.active.title.separator.color: #6dab74

# Inactive window titlebar
window.inactive.title.bg: flat solid
window.inactive.title.bg.color: #2a2a2a
window.inactive.label.bg: flat solid
window.inactive.label.bg.color: #2a2a2a
window.inactive.label.text.color: #777777

# Inactive window handle and border
window.inactive.handle.bg: flat solid
window.inactive.handle.bg.color: #3a3a3a
window.inactive.grip.bg: flat solid
window.inactive.grip.bg.color: #3a3a3a
window.inactive.border.color: #3a3a3a
window.inactive.title.separator.color: #3a3a3a

# Buttons — active window
window.active.button.unpressed.bg: flat solid
window.active.button.unpressed.bg.color: #1e1e1e
window.active.button.unpressed.image.color: #6dab74
window.active.button.pressed.bg: flat solid
window.active.button.pressed.bg.color: #6dab74
window.active.button.pressed.image.color: #ffffff
window.active.button.hover.bg: flat solid
window.active.button.hover.bg.color: #4a8a50
window.active.button.hover.image.color: #ffffff

# Buttons — inactive window
window.inactive.button.unpressed.bg: flat solid
window.inactive.button.unpressed.bg.color: #2a2a2a
window.inactive.button.unpressed.image.color: #555555
window.inactive.button.pressed.bg: flat solid
window.inactive.button.pressed.bg.color: #3a3a3a
window.inactive.button.pressed.image.color: #888888

# Menu
menu.title.bg: flat solid
menu.title.bg.color: #1e1e1e
menu.title.text.color: #6dab74
menu.title.text.font: sans:size=10:bold
menu.items.bg: flat solid
menu.items.bg.color: #2a2a2a
menu.items.text.color: #e0e0e0
menu.items.active.bg: flat solid
menu.items.active.bg.color: #6dab74
menu.items.active.text.color: #ffffff
menu.items.disabled.text.color: #555555
menu.border.color: #6dab74
menu.border.width: 1
menu.overlap.x: 0
menu.overlap.y: 0

# Geometry
padding.width: 4
padding.height: 3
border.width: 0
window.handle.width: 0
