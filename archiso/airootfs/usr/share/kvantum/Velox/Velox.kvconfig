[%General]
author=Velox Linux
comment=Dark theme with Velox green accents
x11drag=true
alt_mnemonic=true
left_tabs=true
attach_active_tab=false
mirror_doc_tabs=true
group_toolbar_buttons=false
spread_progressbar=true
composite=true
menu_shadow_depth=6
tooltip_shadow_depth=4
contrast=1.0
intensity=1.0
saturation=1.0
scroll_width=8
scroll_arrows=false
scroll_min_extent=36
transient_scrollbar=true
tooltip_delay=-1

[GeneralColors]
window.color=#1a1a1a
base.color=#232323
alt.base.color=#1e1e1e
button.color=#2a2a2a
light.color=#3a3a3a
mid.color=#252525
dark.color=#141414
highlight.color=#5a8160
inactive.highlight.color=#3d5c40
text.color=#ffffff
window.text.color=#ffffff
button.text.color=#ffffff
disabled.text.color=#666666
tooltip.base.color=#1a1a1a
tooltip.text.color=#ffffff
link.color=#6dab74
link.visited.color=#4a7a50

[Hacks]
transparent_ktitle_label=true
transparent_dolphin_view=true
transparent_pcmanfm_sidepane=true
blur_translucent=true
transparent_menutitle=true
opaque_colors=false
style_vertical_toolbars=true
