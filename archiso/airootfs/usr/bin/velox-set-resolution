#!/usr/bin/env python3
import glob, os, re, subprocess, sys, time, traceback
from pathlib import Path

LOG = Path("/tmp/velox-set-resolution.log")
def log(msg):
    with open(LOG, 'a') as f:
        f.write(f"{time.strftime('%H:%M:%S')} {msg}\n")

done_flag = Path(os.environ.get("HOME", "/root")) / ".config/velox-resolution-configured"
done_flag.parent.mkdir(parents=True, exist_ok=True)
try:
    open(done_flag, 'x').close()  # atomic exclusive create — second instance exits here
except FileExistsError:
    sys.exit(0)

log(f"starting, DISPLAY={os.environ.get('DISPLAY')}, WAYLAND_DISPLAY={os.environ.get('WAYLAND_DISPLAY')}")


def is_cinnamon_running():
    return subprocess.run(['pgrep', '-x', 'cinnamon'], capture_output=True).returncode == 0


def get_muffin_proxy():
    try:
        import gi
        gi.require_version('Gio', '2.0')
        from gi.repository import Gio
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        proxy = Gio.DBusProxy.new_sync(
            bus, Gio.DBusProxyFlags.NONE, None,
            'org.cinnamon.Muffin.DisplayConfig',
            '/org/cinnamon/Muffin/DisplayConfig',
            'org.cinnamon.Muffin.DisplayConfig',
            None
        )
        return proxy
    except Exception as e:
        log(f"muffin proxy failed: {e}")
        return None


def get_muffin_info(proxy):
    try:
        from gi.repository import Gio
        state = proxy.call_sync('GetCurrentState', None, Gio.DBusCallFlags.NONE, -1, None)
        serial, monitors, logical_monitors, props = state.unpack()
        if not monitors:
            return None
        conn_info = monitors[0][0]
        modes = monitors[0][1]
        connector = conn_info[0]
        resolutions, current_res = [], None
        for mode in modes:
            mid, w, h = mode[0], int(mode[1]), int(mode[2])
            props_dict = mode[6] if len(mode) > 6 else {}
            res = f"{w}x{h}"
            if res not in resolutions:
                resolutions.append(res)
            if props_dict.get('is-current'):
                current_res = res
        log(f"muffin: connector={connector}, current={current_res}, modes={len(modes)}, resolutions={resolutions[:6]}")
        return {'serial': serial, 'connector': connector, 'modes': modes,
                'resolutions': resolutions, 'current': current_res}
    except Exception as e:
        log(f"muffin get_info failed: {e}")
        return None


def get_xrandr_resolutions():
    try:
        raw = subprocess.check_output(['xrandr', '--query'], stderr=subprocess.DEVNULL, text=True)
        output = None
        for line in raw.splitlines():
            if ' connected' in line:
                output = line.split()[0]
                break
        if not output:
            return None, []
        resolutions = []
        in_output = False
        for line in raw.splitlines():
            if line.startswith(output):
                in_output = True
                continue
            if in_output:
                if line and not line[0].isspace():
                    break
                m = re.match(r'\s+(\d+x\d+)', line)
                if m and m.group(1) not in resolutions:
                    resolutions.append(m.group(1))
        log(f"xrandr: output={output}, resolutions={resolutions[:5]}")
        return output, resolutions
    except Exception as e:
        log(f"xrandr failed: {e}")
        return None, []


def best_res(resolutions):
    if '1920x1080' in resolutions:
        return '1920x1080'
    best, best_px = None, 0
    for res in resolutions:
        w, h = map(int, res.split('x'))
        if w * h > best_px:
            best_px, best = w * h, res
    return best


def apply_via_muffin(proxy, info, target_res):
    tw, th = map(int, target_res.split('x'))
    try:
        from gi.repository import Gio, GLib
        mode_id = None
        for mode in info['modes']:
            mid, w, h = mode[0], int(mode[1]), int(mode[2])
            if w == tw and h == th:
                mode_id = mid
                break
        if not mode_id:
            log(f"muffin: no mode for {target_res}")
            return False
        log(f"muffin: applying {target_res} mode={mode_id} on {info['connector']}")
        variant = GLib.Variant(
            '(uua(iiduba(ssa{sv}))a{sv})',
            (info['serial'], 2, [(0, 0, 1.0, 0, True, [(info['connector'], mode_id, {})])], {})
        )
        proxy.call_sync('ApplyMonitorsConfig', variant, Gio.DBusCallFlags.NONE, -1, None)
        log(f"muffin: ApplyMonitorsConfig OK")
        return True
    except Exception as e:
        log(f"muffin apply failed: {e}")
        return False


def apply_via_xrandr(xoutput, target_res):
    log(f"xrandr: --output {xoutput} --mode {target_res}")
    r = subprocess.run(['xrandr', '--output', xoutput, '--mode', target_res],
                       capture_output=True, text=True)
    log(f"xrandr: rc={r.returncode} {r.stderr.strip()}")
    return r.returncode == 0


def refresh_wallpaper_gsettings(env):
    """For Cinnamon sessions: force nemo-desktop to re-render at new resolution."""
    try:
        uri = subprocess.check_output(
            ['gsettings', 'get', 'org.cinnamon.desktop.background', 'picture-uri'],
            env=env, text=True, stderr=subprocess.DEVNULL).strip().strip("'\"")
        if not uri:
            log("gsettings refresh: no URI found")
            return
        log(f"gsettings refresh: uri={uri}")
        time.sleep(3)  # let Cinnamon/Muffin finish reconfiguring display
        subprocess.run(['gsettings', 'set', 'org.cinnamon.desktop.background',
                        'picture-options', 'zoom'], env=env, stderr=subprocess.DEVNULL)
        time.sleep(0.2)
        # Clear URI first — forces a real change event so nemo-desktop re-renders
        subprocess.run(['gsettings', 'set', 'org.cinnamon.desktop.background',
                        'picture-uri', ''], env=env, stderr=subprocess.DEVNULL)
        time.sleep(0.5)
        subprocess.run(['gsettings', 'set', 'org.cinnamon.desktop.background',
                        'picture-uri', uri], env=env, stderr=subprocess.DEVNULL)
        log(f"gsettings wallpaper refreshed: {uri}")
    except Exception as e:
        log(f"gsettings wallpaper refresh failed: {e}")


def refresh_wallpaper_feh(env):
    """For X11/openbox live sessions: re-run feh so the new screen size gets filled."""
    candidates = sorted(glob.glob('/usr/share/wallpapers/Velox-*/contents/images/3840x2160.png'))
    if not candidates:
        log("feh refresh: no Velox wallpapers found")
        return
    wallpaper = candidates[0]
    r = subprocess.run(['feh', '--bg-scale', wallpaper], env=env,
                       capture_output=True, text=True)
    log(f"feh refresh: rc={r.returncode} wall={wallpaper}")


def show_resolution_dialog(target, env):
    """Show Velox dark-themed resolution dialog. Returns True if Apply clicked."""
    try:
        import gi
        gi.require_version('Gtk', '3.0')
        from gi.repository import Gtk, Gdk

        css = b"""
window, dialog, .dialog-vbox, box, grid {
    background-color: #1a1a1a;
    color: #e0e0e0;
}
* { color: #e0e0e0; }
label { color: #e0e0e0; }
button {
    background-image: none;
    background-color: #2d2d2d;
    color: #e0e0e0;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 5px 14px;
    box-shadow: none;
}
button:hover {
    background-image: none;
    background-color: #3d3d3d;
    border-color: #6dab74;
}
button.suggested-action {
    background-image: none;
    background-color: #6dab74;
    color: #ffffff;
    border-color: #4a8a50;
}
button.suggested-action:hover {
    background-image: none;
    background-color: #7dbb84;
}
"""
        provider = Gtk.CssProvider()
        provider.load_from_data(css)
        screen = Gdk.Screen.get_default()
        if screen:
            Gtk.StyleContext.add_provider_for_screen(
                screen, provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
            )

        dlg = Gtk.Dialog(title="Velox Linux — Display Setup")
        dlg.set_default_size(380, -1)
        dlg.set_border_width(24)
        dlg.set_resizable(False)

        content = dlg.get_content_area()
        content.set_spacing(0)

        lbl = Gtk.Label()
        lbl.set_markup(
            f"Best available resolution detected:\n\n"
            f"<b><big><span foreground='#6dab74'>{target}</span></big></b>\n\n"
            f"Apply this resolution now?"
        )
        lbl.set_justify(Gtk.Justification.CENTER)
        lbl.set_margin_bottom(20)
        content.pack_start(lbl, True, True, 0)

        btn_cancel = dlg.add_button("Keep current", Gtk.ResponseType.CANCEL)
        btn_apply = dlg.add_button("Apply", Gtk.ResponseType.OK)
        btn_apply.get_style_context().add_class("suggested-action")
        dlg.set_default_response(Gtk.ResponseType.OK)

        dlg.show_all()
        response = dlg.run()
        dlg.destroy()
        return response == Gtk.ResponseType.OK

    except Exception as e:
        log(f"GTK dialog failed ({e}), falling back to zenity")
        result = subprocess.run(
            ['zenity', '--question',
             '--title=Velox Linux — Display Setup',
             f'--text=Best available resolution detected:\n\n<b><big>{target}</big></b>\n\nApply this resolution now?',
             '--ok-label=Apply',
             '--cancel-label=Keep current',
             '--width=360'],
            env=env
        )
        return result.returncode == 0


def is_kde_wayland():
    return (os.environ.get('XDG_CURRENT_DESKTOP', '') == 'KDE' and
            bool(os.environ.get('WAYLAND_DISPLAY')))


def strip_ansi(text):
    return re.sub(r'\x1b\[[0-9;]*m', '', text)


def get_kscreen_info():
    """Query kscreen-doctor for outputs on KDE Wayland."""
    try:
        raw = subprocess.check_output(
            ['kscreen-doctor', '--outputs'], text=True, stderr=subprocess.DEVNULL)
        output_name, output_uuid, current_res, resolutions, mode_map = None, None, None, [], {}
        for line in raw.splitlines():
            clean = strip_ansi(line).strip()
            m = re.match(r'Output:\s*\d+\s+(\S+)\s+(\S+)', clean)
            if m:
                output_name, output_uuid = m.group(1), m.group(2)
                continue
            if 'Modes:' in clean:
                for token in clean.split():
                    mm = re.match(r'(\d+):([\dx]+)@([\d.]+)([*!]*)', token)
                    if mm:
                        mid, res, rate, flags = mm.group(1), mm.group(2), mm.group(3), mm.group(4)
                        if res not in resolutions:
                            resolutions.append(res)
                            mode_map[res] = (mid, int(float(rate) * 1000))
                        if '*' in flags:
                            current_res = res
        log(f"kscreen: output={output_name}, uuid={output_uuid}, current={current_res}, modes={resolutions[:6]}")
        return output_name, output_uuid, current_res, resolutions, mode_map
    except Exception as e:
        log(f"kscreen-doctor failed: {e}")
        return None, None, None, [], {}


def write_kwinoutputconfig(uuid, target_res, mode_map):
    """Write resolution directly to kwinoutputconfig.json — same as System Settings."""
    import json
    config_path = Path(os.environ.get("HOME", "/root")) / ".config/kwinoutputconfig.json"
    w, h = map(int, target_res.split('x'))
    refresh_mhz = mode_map[target_res][1]

    if config_path.exists():
        try:
            cfg = json.loads(config_path.read_text())
        except Exception:
            cfg = []
    else:
        cfg = []

    # Find or create the outputs section
    outputs_section = next((s for s in cfg if s.get('name') == 'outputs'), None)
    if outputs_section is None:
        outputs_section = {'name': 'outputs', 'data': []}
        cfg.append(outputs_section)

    # Find the entry for this UUID or create it
    entry = next((e for e in outputs_section['data'] if e.get('uuid') == uuid), None)
    if entry is None:
        entry = {'uuid': uuid, 'connectorName': 'Virtual-1'}
        outputs_section['data'].append(entry)

    entry['mode'] = {'flags': 0, 'height': h, 'refreshRate': refresh_mhz, 'width': w}

    config_path.write_text(json.dumps(cfg, indent=4))
    log(f"kwinoutputconfig: wrote {target_res}@{refresh_mhz}mHz for uuid={uuid}")
    return True


def apply_via_kscreen(output_name, mode_map, target_res):
    """Apply resolution via kscreen-doctor on KDE Wayland."""
    if target_res not in mode_map:
        log(f"kscreen: no mode entry for {target_res}")
        return False
    mode_id = mode_map[target_res][0]  # numeric mode ID e.g. "13"
    cmd = ['kscreen-doctor', f'output.{output_name}.mode.{mode_id}']
    log(f"kscreen: running {' '.join(cmd)}")
    r = subprocess.run(cmd, capture_output=True, text=True)
    log(f"kscreen: rc={r.returncode} {r.stderr.strip()}")
    return r.returncode == 0


def main():
    env = os.environ.copy()
    if 'DISPLAY' not in env:
        env['DISPLAY'] = ':1'
    if 'DISPLAY' not in os.environ:
        os.environ['DISPLAY'] = env['DISPLAY']

    proxy, muffin_info = None, None
    kscreen_output, kscreen_uuid, kscreen_current, kscreen_resolutions, kscreen_mode_map = None, None, None, [], {}
    xoutput = None

    if is_kde_wayland():
        log("KDE Wayland session — using kscreen-doctor")
        kscreen_output, kscreen_uuid, kscreen_current, kscreen_resolutions, kscreen_mode_map = get_kscreen_info()
        resolutions = kscreen_resolutions
        current_res = kscreen_current
    elif is_cinnamon_running():
        log("Cinnamon session — using Muffin D-Bus")
        for attempt in range(4):
            proxy = get_muffin_proxy()
            if proxy:
                muffin_info = get_muffin_info(proxy)
                if muffin_info:
                    break
            log(f"muffin not ready (attempt {attempt+1}), retrying...")
            time.sleep(3)
        if muffin_info:
            resolutions = muffin_info['resolutions']
            current_res = muffin_info['current']
        else:
            log("muffin unavailable, falling back to xrandr")
            xoutput, resolutions = get_xrandr_resolutions()
            current_res = resolutions[0] if resolutions else None
    else:
        log("X11 session — using xrandr")
        xoutput, resolutions = get_xrandr_resolutions()
        current_res = resolutions[0] if resolutions else None

    if not resolutions:
        log("no resolutions found, exiting")
        done_flag.touch()
        return

    target = best_res(resolutions)
    if not target:
        log("no best resolution found")
        done_flag.touch()
        return

    if target == current_res and not is_kde_wayland():
        log(f"already at best resolution {target}, nothing to do")
        done_flag.touch()
        return

    log(f"target={target}, current={current_res}")

    if show_resolution_dialog(target, env):
        log("user clicked Apply")
        if not is_kde_wayland():
            subprocess.run(['gsettings', 'set', 'org.cinnamon.desktop.background',
                            'picture-options', 'zoom'], env=env, stderr=subprocess.DEVNULL)
        applied = False
        if kscreen_output:
            applied = apply_via_kscreen(kscreen_output, kscreen_mode_map, target)
            if applied and kscreen_uuid:
                write_kwinoutputconfig(kscreen_uuid, target, kscreen_mode_map)
        if not applied and proxy and muffin_info:
            applied = apply_via_muffin(proxy, muffin_info, target)
        if not applied and xoutput:
            applied = apply_via_xrandr(xoutput, target)
        if applied:
            log("resolution applied, launching velox-reload-desktop")
            subprocess.Popen(['velox-reload-desktop'], env=env)
    else:
        log("user cancelled")

    done_flag.touch()
    log("done")


main()
