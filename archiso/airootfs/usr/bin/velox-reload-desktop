#!/bin/bash
# Reload desktop environment after a resolution change.

sleep 2  # let the display finish reconfiguring

if pgrep -x plasmashell > /dev/null 2>&1; then
    # KDE Wayland: kscreen-doctor applied the resolution live; kwinoutputconfig.json
    # was written for persistence. Plasmashell receives the Wayland output-change event
    # and redraws the wallpaper automatically. Just restart ksmoothdock so it
    # repositions itself to the new screen geometry.
    sleep 2
    pkill -x ksmoothdock 2>/dev/null
    sleep 1
    /usr/local/bin/ksmoothdock-start &

elif pgrep -x cinnamon > /dev/null 2>&1; then
    # Cinnamon Wayland: the background surface is sized at compositor startup and
    # does not resize when the display resolution changes. A full session logout is
    # required so SDDM relaunches Cinnamon fresh at the new resolution.
    # ApplyMonitorsConfig (method=2) already wrote cinnamon-monitors.xml, so the
    # next Cinnamon startup reads it and starts at 1920x1080.
    # Use cinnamon-session-quit for a clean logout so SDDM restarts the greeter properly.
    cinnamon-session-quit --logout --no-prompt 2>/dev/null

else
    # Fallback for X11/OpenBox live session
    for wall in /usr/share/wallpapers/Velox-*/contents/images/3840x2160.png; do
        [ -f "$wall" ] && feh --bg-scale "$wall" && break
    done
fi
