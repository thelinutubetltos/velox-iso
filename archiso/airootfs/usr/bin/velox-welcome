    # ── Snapper ──────────────────────────────────────────────
    def tab_snapper(self):
        inner = QWidget()
        layout = QVBoxLayout(inner)
        layout.setContentsMargins(20, 16, 20, 20)
        layout.setSpacing(12)

        self.section(layout, "Status")
        self.snapper_status = QLabel()
        self.snapper_status.setStyleSheet(f"font-size: 12px; color: {TEXT_DIM}; padding: 2px 0;")
        layout.addWidget(self.snapper_status)
        self.refresh_snapper_status()

        info = QLabel("Snapper saves Btrfs snapshots before/after system changes. grub-btrfs makes them bootable.")
        info.setStyleSheet(f"color: {TEXT_DIM}; font-size: 11px; padding: 2px 0 8px 0;")
        info.setWordWrap(True)
        layout.addWidget(info)

        self.section(layout, "Setup")
        self.tile_grid(layout, [
            ("📦", "Install Snapper + grub-btrfs", "snapper grub-btrfs inotify-tools",
                lambda: self.run_cmd("paru -Sy --needed snapper grub-btrfs inotify-tools")),
            ("🔧", "Create root config", "snapper -c root create-config",
                lambda: self.run_cmd("sudo snapper -c root create-config / && sudo systemctl enable --now snapper-timeline.timer snapper-cleanup.timer")),
            ("🔄", "Enable grub-btrfs", "Auto-update boot menu",
                lambda: self.run_cmd("sudo systemctl enable --now grub-btrfsd && sudo grub-mkconfig -o /boot/grub/grub.cfg")),
        ], cols=3)

        self.section(layout, "Manage Snapshots")
        self.tile_grid(layout, [
            ("📷", "Take snapshot", "Manual snapshot now",
                lambda: self.run_cmd("sudo snapper -c root create --description 'Manual snapshot'")),
            ("📋", "List snapshots", "Show all snapshots",
                lambda: self.run_cmd("snapper -c root list")),
            ("🗑", "Cleanup old", "Keep last 5",
                lambda: self.run_cmd("sudo snapper -c root cleanup number")),
        ], cols=3)

        layout.addStretch()
        return self.scroll_wrap(inner)

    def refresh_snapper_status(self):
        snapper_ok = has_cmd("snapper")
        config_ok = Path("/etc/snapper/configs/root").exists()
        grub_ok = has_cmd("grub-btrfsd")
        if snapper_ok and config_ok and grub_ok:
            self.snapper_status.setText("✅  Snapper is configured and active")
            self.snapper_status.setStyleSheet(f"color: {VELOX_GREEN_HI}; font-size: 12px;")
        elif snapper_ok:
            self.snapper_status.setText("⚠  Snapper installed but not configured")
            self.snapper_status.setStyleSheet("color: #cc8800; font-size: 12px;")
        else:
            self.snapper_status.setText("❌  Snapper not installed")
            self.snapper_status.setStyleSheet(f"color: {VELOX_RED}; font-size: 12px;")

    # ── Packages ─────────────────────────────────────────────
    def tab_packages(self):
        outer = QWidget()
        layout = QVBoxLayout(outer)
        layout.setContentsMargins(20, 16, 20, 20)
        layout.setSpacing(10)

        self.section(layout, "Package Search & Install")

        # Status badges
        helper = get_aur_helper()
        flatpak_ok = has_cmd("flatpak")
        chaotic_ok = Path("/etc/pacman.d/chaotic-mirrorlist").exists()

        badge_row = QHBoxLayout()
        def badge(text, ok):
            l = QLabel(f"{'✅' if ok else '❌'}  {text}")
            l.setStyleSheet(f"color: {'#5a8160' if ok else '#8a1a1a'}; font-size: 11px; "
                           f"background: {'#1e2e18' if ok else '#1f1010'}; "
                           f"border: 1px solid {'#3a5228' if ok else '#3a1a1a'}; "
                           f"border-radius: 4px; padding: 3px 8px;")
            return l
        badge_row.addWidget(badge(f"AUR ({helper or 'none'})", helper is not None))
        badge_row.addWidget(badge("Chaotic-AUR", chaotic_ok))
        badge_row.addWidget(badge("Flatpak", flatpak_ok))
        badge_row.addStretch()
        layout.addLayout(badge_row)

        # Source + search
        search_row = QHBoxLayout()
        self.source_combo = QComboBox()
        self.source_combo.addItems(["Pacman + Chaotic", "AUR", "Flatpak"])
        self.source_combo.setMaximumWidth(180)
        search_row.addWidget(self.source_combo)
        self.pkg_search_box = QLineEdit()
        self.pkg_search_box.setPlaceholderText("Search packages...")
        self.pkg_search_box.returnPressed.connect(self.search_packages)
        search_row.addWidget(self.pkg_search_box)
        search_btn = QPushButton("Search")
        search_btn.setObjectName("install")
        search_btn.setMaximumWidth(100)
        search_btn.setMinimumHeight(36)
        search_btn.clicked.connect(self.search_packages)
        search_row.addWidget(search_btn)
        layout.addLayout(search_row)

        self.pkg_status = QLabel("Select a source and search for a package")
        self.pkg_status.setStyleSheet(f"color: {TEXT_DIM}; font-size: 11px;")
        layout.addWidget(self.pkg_status)

        self.pkg_list = QListWidget()
        self.pkg_list.itemSelectionChanged.connect(self.on_pkg_selected)
        layout.addWidget(self.pkg_list)

        self.pkg_desc = QLabel("")
        self.pkg_desc.setStyleSheet(f"color: {TEXT_DIM}; font-size: 11px;")
        self.pkg_desc.setWordWrap(True)
        layout.addWidget(self.pkg_desc)

        self.pkg_install_btn = QPushButton("Select a package to install")
        self.pkg_install_btn.setObjectName("install")
        self.pkg_install_btn.setMinimumHeight(44)
        self.pkg_install_btn.setEnabled(False)
        self.pkg_install_btn.clicked.connect(self.install_selected)
        layout.addWidget(self.pkg_install_btn)

        if not flatpak_ok:
            self.tile_grid(layout, [
                ("📦", "Enable Flatpak + Flathub", "Install flatpak support",
                    lambda: self.run_cmd(
                        "sudo pacman -Sy --needed flatpak && "
                        "flatpak remote-add --if-not-exists flathub "
                        "https://dl.flathub.org/repo/flathub.flatpakrepo")),
            ], cols=1)

        if not helper:
            self.tile_grid(layout, [
                ("⚙", "Install paru (AUR helper)", "Build from AUR",
                    lambda: self.run_cmd(
                        "sudo pacman -Sy --needed base-devel git && "
                        "git clone https://aur.archlinux.org/paru.git /tmp/paru-build && "
                        "cd /tmp/paru-build && makepkg -si")),
            ], cols=1)

        return outer

    def search_packages(self):
        query = self.pkg_search_box.text().strip()
        if not query:
            return
        source_map = {0: "pacman", 1: "aur", 2: "flatpak"}
        source = source_map.get(self.source_combo.currentIndex(), "pacman")
        self.pkg_status.setText(f"Searching '{query}'...")
        self.pkg_list.clear()
        self.pkg_desc.setText("")
        self.pkg_install_btn.setEnabled(False)
        self.pkg_install_btn.setText("Select a package to install")
        self.search_thread = SearchThread(query, source)
        self.search_thread.results_ready.connect(self.on_search_results)
        self.search_thread.start()

    def on_search_results(self, packages):
        self.pkg_list.clear()
        if not packages:
            self.pkg_status.setText("No results found.")
            return
        self.pkg_status.setText(f"{len(packages)} results")
        for pkg_id, name, desc, source in packages:
            item = QListWidgetItem(f"{name}  [{source}]")
            item.setData(Qt.ItemDataRole.UserRole, (pkg_id, desc, source))
            self.pkg_list.addItem(item)

    def on_pkg_selected(self):
        items = self.pkg_list.selectedItems()
        if items:
            pkg_id, desc, source = items[0].data(Qt.ItemDataRole.UserRole)
            self.selected_pkg = pkg_id
            self.selected_source = source
            self.pkg_desc.setText(desc)
            self.pkg_install_btn.setEnabled(True)
            self.pkg_install_btn.setText(f"Install  {pkg_id}")

    def install_selected(self):
        if not self.selected_pkg:
            return
        if "flatpak" in (self.selected_source or ""):
            self.run_cmd(f"flatpak install flathub {self.selected_pkg}", f"Install {self.selected_pkg}")
        else:
            self.install(self.selected_pkg)

    # ── About ────────────────────────────────────────────────
    def tab_about(self):
        inner = QWidget()
        layout = QVBoxLayout(inner)
        layout.setContentsMargins(20, 16, 20, 20)
        layout.setSpacing(12)

        self.section(layout, "About Velox Linux")
        about = QLabel(
            "Velox Linux is an Arch-based KDE Plasma distribution focused on\n"
            "performance, customization, and a great out-of-the-box experience.\n\n"
            "Built by The Linux Tube for creators, gamers, and power users."
        )
        about.setStyleSheet(f"color: {TEXT_DIM}; font-size: 13px; padding: 8px 0;")
        about.setWordWrap(True)
        layout.addWidget(about)

        self.section(layout, "Links")
        self.tile_grid(layout, [
            ("🐙", "GitHub Repository", "velox-iso source", lambda: subprocess.Popen(["xdg-open", "https://github.com/thelinutubetltos/velox-iso"])),
            ("📺", "YouTube Channel", "@thelinuxtube", lambda: subprocess.Popen(["xdg-open", "https://youtube.com/@thelinuxtube"])),
            ("🐛", "Report a Bug", "GitHub issues", lambda: subprocess.Popen(["xdg-open", "https://github.com/thelinutubetltos/velox-iso/issues"])),
            ("📦", "Velox Repository", "velox_repo", lambda: subprocess.Popen(["xdg-open", "https://github.com/thelinutubetltos/velox_repo"])),
        ], cols=2)

        layout.addStretch()
        return self.scroll_wrap(inner)


if __name__ == "__main__":
    app = QApplication(sys.argv)
    app.setApplicationName("Velox Welcome")
    window = VeloxWelcome()
    window.show()
    sys.exit(app.exec())
