def has_cmd(cmd):
    return subprocess.run(["which", cmd], capture_output=True).returncode == 0

def get_aur_helper():
    for h in ["paru", "yay"]:
        if has_cmd(h):
            return h
    return None


class SearchThread(QThread):
    results_ready = pyqtSignal(list)

    def __init__(self, query, source):
        super().__init__()
        self.query = query
        self.source = source

    def run(self):
        packages = []
        try:
            if self.source == "flatpak":
                result = subprocess.run(
                    ["flatpak", "search", "--columns=application,name,description", self.query],
                    capture_output=True, text=True, timeout=20)
                for line in result.stdout.strip().split('\n')[1:]:
                    parts = line.split('\t')
                    if len(parts) >= 2:
                        app_id = parts[0].strip()
                        name = parts[1].strip() if len(parts) > 1 else app_id
                        desc = parts[2].strip() if len(parts) > 2 else ""
                        packages.append((app_id, name, desc, "flatpak"))
            elif self.source == "aur":
                helper = get_aur_helper()
                if helper:
                    result = subprocess.run(
                        [helper, "-Ss", "--aur", self.query],
                        capture_output=True, text=True, timeout=20)
                    packages = self._parse_pacman(result.stdout, "aur")
            else:
                result = subprocess.run(
                    ["pacman", "-Ss", self.query],
                    capture_output=True, text=True, timeout=15)
                packages = self._parse_pacman(result.stdout, "pacman")
        except Exception:
            pass
        self.results_ready.emit(packages[:60])

    def _parse_pacman(self, output, source):
        packages = []
        lines = output.strip().split('\n')
        i = 0
        while i < len(lines):
            line = lines[i]
            if line and not line.startswith(' ') and not line.startswith('\t'):
                parts = line.split('/')
                if len(parts) >= 2:
                    name = parts[-1].split(' ')[0]
                    desc = lines[i+1].strip() if i+1 < len(lines) else ""
                    repo = parts[0]
                    packages.append((name, name, desc, f"{repo}"))
            i += 1
        return packages


class VeloxWelcome(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("Welcome to Velox Linux")
        self.setMinimumSize(920, 680)
        self.setStyleSheet(STYLE)
        self.autostart_path = Path.home() / ".config/autostart/velox-welcome.desktop"
        self.search_thread = None
        self.selected_pkg = None
        self.selected_source = None
        self.setup_ui()

    def setup_ui(self):
        central = QWidget()
        self.setCentralWidget(central)
        main_layout = QVBoxLayout(central)
        main_layout.setSpacing(0)
        main_layout.setContentsMargins(0, 0, 0, 0)

        # Header
        header = QFrame()
        header.setStyleSheet(f"background-color: {DARKER_BG}; border-bottom: 2px solid {VELOX_GREEN};")
        hl = QHBoxLayout(header)
        hl.setContentsMargins(24, 16, 24, 16)

        logo_label = QLabel()
        logo_path = "/usr/share/velox-welcome/velox-logo.png"
        if os.path.exists(logo_path):
            pixmap = QPixmap(logo_path).scaled(56, 56, Qt.AspectRatioMode.KeepAspectRatio,
                Qt.TransformationMode.SmoothTransformation)
            logo_label.setPixmap(pixmap)
        hl.addWidget(logo_label)

        title_col = QVBoxLayout()
        title_col.setSpacing(2)
        title = QLabel("Welcome to Velox Linux")
        title.setObjectName("header")
        tagline = QLabel("Shape It. Race It. Own It.")
        tagline.setObjectName("tagline")
        title_col.addWidget(title)
        title_col.addWidget(tagline)
        hl.addLayout(title_col)
        hl.addStretch()
        main_layout.addWidget(header)

        tabs = QTabWidget()
        tabs.setContentsMargins(0, 0, 0, 0)
        tabs.addTab(self.tab_firststeps(), "First Steps")
        tabs.addTab(self.tab_gaming(), "Gaming")
        tabs.addTab(self.tab_creative(), "Creative")
        tabs.addTab(self.tab_internet(), "Internet")
        tabs.addTab(self.tab_kernels(), "Kernels")
        tabs.addTab(self.tab_snapper(), "Snapshots")
        tabs.addTab(self.tab_packages(), "Packages")
        tabs.addTab(self.tab_about(), "About")
        main_layout.addWidget(tabs)

    # ── Helpers ──────────────────────────────────────────────

    def scroll_wrap(self, inner):
        scroll = QScrollArea()
        scroll.setWidgetResizable(True)
        scroll.setWidget(inner)
        outer = QWidget()
        ol = QVBoxLayout(outer)
        ol.setContentsMargins(0, 0, 0, 0)
        ol.addWidget(scroll)
        return outer

    def section(self, layout, text):
        lbl = QLabel(text.upper())
        lbl.setObjectName("section")
        layout.addWidget(lbl)

    def tile_grid(self, layout, items, cols=3):
        grid = QGridLayout()
        grid.setSpacing(8)
        for i, (icon, label, sub, cmd) in enumerate(items):
            btn = self.make_tile(icon, label, sub, cmd)
            grid.addWidget(btn, i // cols, i % cols)
        layout.addLayout(grid)

    def make_tile(self, icon, label, sub, callback):
        btn = QPushButton()
        btn.setObjectName("tile")
        btn.setCursor(QCursor(Qt.CursorShape.PointingHandCursor))
        btn.setMinimumHeight(58)
        inner = QHBoxLayout(btn)
        inner.setContentsMargins(10, 8, 10, 8)
        inner.setSpacing(10)
        icon_lbl = QLabel(icon)
        icon_lbl.setStyleSheet("font-size: 18px; background: transparent; border: none;")
        icon_lbl.setFixedWidth(26)
        inner.addWidget(icon_lbl)
        text_col = QVBoxLayout()
        text_col.setSpacing(1)
        name_lbl = QLabel(label)
        name_lbl.setStyleSheet(f"font-size: 12px; color: {TEXT}; background: transparent; border: none;")
        text_col.addWidget(name_lbl)
        if sub:
            sub_lbl = QLabel(sub)
            sub_lbl.setStyleSheet(f"font-size: 10px; color: {TEXT_DIM}; background: transparent; border: none;")
            text_col.addWidget(sub_lbl)
        inner.addLayout(text_col)
        inner.addStretch()
        if callable(callback):
            btn.clicked.connect(callback)
        return btn

    def run_cmd(self, cmd, title="Run command"):
        reply = QMessageBox.question(self, title,
            f"Run the following command?\n\n{cmd}",
            QMessageBox.StandardButton.Yes | QMessageBox.StandardButton.No)
        if reply == QMessageBox.StandardButton.Yes:
            subprocess.Popen(["konsole", "-e", "bash", "-c",
                f"{cmd}; echo; echo 'Done. Press Enter to close...'; read"])

    def install(self, pkg):
        helper = get_aur_helper()
        cmd = f"{helper} -Sy --needed {pkg}" if helper else f"sudo pacman -Sy --needed {pkg}"
        self.run_cmd(cmd, f"Install {pkg}")

    def toggle_autostart(self, checked):
        if checked:
            src = Path("/usr/share/applications/velox-welcome.desktop")
            self.autostart_path.parent.mkdir(parents=True, exist_ok=True)
            if src.exists():
                shutil.copy2(src, self.autostart_path)
            else:
                self.autostart_path.write_text(
                    "[Desktop Entry]\nType=Application\nName=Velox Welcome\n"
                    "Exec=velox-welcome\nTerminal=false\nHidden=false\n"
                    "X-KDE-autostart-phase=2\n")
        else:
            if self.autostart_path.exists():
                self.autostart_path.unlink()

    # ── First Steps ──────────────────────────────────────────
    def tab_firststeps(self):
        inner = QWidget()
        layout = QVBoxLayout(inner)
        layout.setContentsMargins(20, 16, 20, 20)
        layout.setSpacing(12)

        # Autostart toggle row
        self.section(layout, "Welcome App")
        toggle_row = QFrame()
