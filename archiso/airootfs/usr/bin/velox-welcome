            ("🔴", "AMD drivers", "mesa + vulkan", lambda: self.install("mesa vulkan-radeon libva-mesa-driver")),
        ], cols=2)

        self.section(layout, "System Tools")
        self.tile_grid(layout, [
            ("💾", "Timeshift", "Backup tool", lambda: self.install("timeshift")),
            ("🔥", "Firewall", "Enable UFW", lambda: self.run_cmd("sudo pacman -Sy --needed ufw && sudo ufw enable && sudo systemctl enable ufw")),
            ("📶", "Bluetooth", "Enable service", lambda: self.run_cmd("sudo systemctl enable --now bluetooth")),
        ], cols=3)

        layout.addStretch()
        return self.scroll_wrap(inner)

