        tr = QHBoxLayout(toggle_row)
        tr.setContentsMargins(12, 10, 12, 10)
        toggle_lbl = QLabel("Launch on login")
        toggle_lbl.setStyleSheet(f"color: {TEXT}; font-size: 12px; background: transparent; border: none;")
        sub_lbl = QLabel("Uncheck to stop this app opening on startup")
        sub_lbl.setStyleSheet(f"color: {TEXT_DIM}; font-size: 10px; background: transparent; border: none;")
        text_col = QVBoxLayout()
        text_col.setSpacing(1)
        text_col.addWidget(toggle_lbl)
        text_col.addWidget(sub_lbl)
        tr.addLayout(text_col)
        tr.addStretch()
        cb = QCheckBox()
        cb.setChecked(self.autostart_path.exists())
        cb.setStyleSheet(f"""
            QCheckBox::indicator {{ width: 18px; height: 18px; border: 1px solid {VELOX_GREEN}; border-radius: 4px; background: {DARKER_BG}; }}
            QCheckBox::indicator:checked {{ background: {VELOX_GREEN}; }}
        """)
        cb.stateChanged.connect(lambda s: self.toggle_autostart(s == 2))
        tr.addWidget(cb)
        layout.addWidget(toggle_row)

        self.section(layout, "System")
        self.tile_grid(layout, [
            ("🔄", "Update system", "pacman -Syyu", lambda: self.run_cmd("sudo pacman -Syyu")),
            ("📦", "Update AUR", "paru -Syu", lambda: self.run_cmd(f"{get_aur_helper() or 'paru'} -Syu")),
            ("🧹", "Clean cache", "pacman -Sc", lambda: self.run_cmd("sudo pacman -Sc")),
