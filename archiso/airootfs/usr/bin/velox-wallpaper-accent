#!/usr/bin/env python3
"""Extract a vibrant accent color from the current KDE wallpaper and apply it
to the panel's tray icons + clock text via the Panel Colorizer plasmoid."""
import colorsys
import json
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlparse, unquote

from PIL import Image

APPLETSRC = Path.home() / ".config/plasma-org.kde.plasma.desktop-appletsrc"
KDEGLOBALS = Path.home() / ".config/kdeglobals"
KVANTUM_SYSTEM_DIR = Path("/usr/share/Kvantum/Velox")
KVANTUM_USER_DIR = Path.home() / ".config/Kvantum/Velox"

# Applet ids (this panel layout) that should NOT be recolored.
# Kickoff, clock, and system tray get the accent; leave the rest alone.
BLACKLIST_WIDGETS = [
    {"id": 4, "name": "org.kde.plasma.pager"},
    {"id": 6, "name": "org.kde.plasma.panelspacer"},
    {"id": 24, "name": "org.kde.plasma.panelspacer"},
    {"id": 23, "name": "org.kde.plasma.notifications"},
    {"id": 27, "name": "luisbocanegra.panel.colorizer"},
    {"id": 34, "name": "org.kde.plasma.icontasks"},
]


def current_wallpaper_path():
    text = APPLETSRC.read_text()
    m = re.search(r"^Image=(.+)$", text, re.MULTILINE)
    if not m:
        raise SystemExit("no Image= wallpaper entry found in appletsrc")
    value = m.group(1).strip()
    if value.startswith("file://"):
        path = Path(unquote(urlparse(value).path))
    else:
        path = Path(value)

    # Image= sometimes points at a wallpaper *package* directory (e.g.
    # ".../Velox-12/") rather than a specific rendered file -- resolve to
    # the actual image inside contents/images/.
    if path.is_dir():
        images_dir = path / "contents" / "images"
        if images_dir.is_dir():
            candidates = sorted(images_dir.glob("*.png"), key=lambda p: p.stat().st_size, reverse=True)
            if not candidates:
                candidates = sorted(images_dir.glob("*.jpg"), key=lambda p: p.stat().st_size, reverse=True)
            if candidates:
                return candidates[0]
        raise SystemExit(f"wallpaper path {path} is a directory with no resolvable image")

    return path


def extract_accent(image_path, sat_min=0.35, val_range=(0.35, 0.9),
                    boost_sat=0.92, boost_val=1.0):
    im = Image.open(image_path).convert("RGB")
    im.thumbnail((200, 200))
    quant = im.quantize(colors=24, method=Image.MEDIANCUT)
    palette = quant.getpalette()
    counts = quant.getcolors()  # [(count, index), ...]
    counts.sort(reverse=True)

    candidates = []
    for count, idx in counts:
        r, g, b = palette[idx * 3: idx * 3 + 3]
        h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if s >= sat_min and val_range[0] <= v <= val_range[1]:
            score = s * v * count
            candidates.append((score, r, g, b))

    if not candidates:
        # relax thresholds and just take the most saturated swatch available
        best = None
        for count, idx in counts:
            r, g, b = palette[idx * 3: idx * 3 + 3]
            h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
            score = s * v
            if best is None or score > best[0]:
                best = (score, r, g, b)
        _, r, g, b = best
    else:
        candidates.sort(reverse=True)
        _, r, g, b = candidates[0]

    # Keep the detected hue but resynthesize it at a punchy, high-contrast
    # saturation/value so the accent pops instead of reading as dim/muted --
    # raw wallpaper pixels are often darkened by shadows/compression.
    h, _s, _v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    r, g, b = colorsys.hsv_to_rgb(h, boost_sat, boost_val)
    r, g, b = round(r * 255), round(g * 255), round(b * 255)

    return "#{:02x}{:02x}{:02x}".format(r, g, b)


def build_new_config_lines(hex_color):
    return hex_color


def apply_color(hex_color):
    text = APPLETSRC.read_text()

    # --- globalSettings: enable custom foreground color ---
    m = re.search(r"^globalSettings=(.*)$", text, re.MULTILINE)
    if not m:
        raise SystemExit("globalSettings= line not found (Panel Colorizer not configured?)")
    settings = json.loads(m.group(1))
    # panel.normal.foregroundColor is the panel container's own decoration,
    # not per-widget tinting -- make sure it's left untouched/off.
    settings["panel"]["normal"]["foregroundColor"]["enabled"] = False
    for scope in ("widgets", "trayWidgets"):
        for state in ("normal", "expanded"):
            fg = settings[scope][state]["foregroundColor"]
            fg["enabled"] = True
            fg["sourceType"] = 0
            fg["custom"] = hex_color
    new_settings_line = "globalSettings=" + json.dumps(settings, separators=(",", ":"))
    text = text[:m.start()] + new_settings_line + text[m.end():]

    # --- blacklistedWidgets: keep everything except clock + systray untouched ---
    m = re.search(r"^blacklistedWidgets=(.*)$", text, re.MULTILINE)
    widgets = [dict(w, blacklisted=True) for w in BLACKLIST_WIDGETS]
    payload = {"widgets": widgets}
    new_bl_line = "blacklistedWidgets=" + json.dumps(payload, separators=(",", ":"))
    if m:
        text = text[:m.start()] + new_bl_line + text[m.end():]
    else:
        # insert into the panel colorizer's Configuration/General group
        anchor = "[Containments][2][Applets][27][Configuration][General]\n"
        idx = text.index(anchor) + len(anchor)
        text = text[:idx] + new_bl_line + "\n" + text[idx:]

    APPLETSRC.write_text(text)


def apply_kdeglobals_selection(hex_color):
    """Update the active color scheme's Selection colors so Kickoff's search/
    highlight and other Highlight-driven UI (not reachable via Panel
    Colorizer) also track the wallpaper accent."""
    r, g, b = int(hex_color[1:3], 16), int(hex_color[3:5], 16), int(hex_color[5:7], 16)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)

    mid_r, mid_g, mid_b = (round(c * 255) for c in colorsys.hsv_to_rgb(h, 0.65, 0.65))
    bright_r, bright_g, bright_b = (round(c * 255) for c in colorsys.hsv_to_rgb(h, 0.92, 1.0))

    text = KDEGLOBALS.read_text()
    m = re.search(r"^\[Colors:Selection\]\n(.*?)(?=\n\[|\Z)", text, re.MULTILINE | re.DOTALL)
    if not m:
        return
    block = m.group(1)

    def set_key(block, key, value):
        pattern = rf"^{key}=.*$"
        if re.search(pattern, block, re.MULTILINE):
            return re.sub(pattern, f"{key}={value}", block, flags=re.MULTILINE)
        return block + f"\n{key}={value}"

    block = set_key(block, "BackgroundNormal", f"{mid_r},{mid_g},{mid_b}")
    block = set_key(block, "BackgroundAlternate", f"{mid_r},{mid_g},{mid_b}")
    block = set_key(block, "DecorationFocus", f"{bright_r},{bright_g},{bright_b}")
    block = set_key(block, "DecorationHover", f"{bright_r},{bright_g},{bright_b}")
    block = set_key(block, "ForegroundActive", f"{bright_r},{bright_g},{bright_b}")

    text = text[:m.start(1)] + block + text[m.end(1):]

    # ForegroundNormal in View/Window is the default text color used across
    # basically every KDE app (Kickoff and the tray flyout included) -- user
    # explicitly asked for the red to carry through app text, not just the
    # panel/selection highlight.
    for section in ("Colors:View", "Colors:Window", "Colors:Button",
                     "Colors:Header", "Colors:Complementary", "Colors:Tooltip"):
        sm = re.search(rf"^\[{re.escape(section)}\]\n(.*?)(?=\n\[|\Z)", text, re.MULTILINE | re.DOTALL)
        if not sm:
            continue
        sblock = set_key(sm.group(1), "ForegroundNormal", f"{bright_r},{bright_g},{bright_b}")
        text = text[:sm.start(1)] + sblock + text[sm.end(1):]

    KDEGLOBALS.write_text(text)


def apply_kvantum_theme(hex_color):
    """Kvantum (the Qt-widget theme behind the desktop right-click menu,
    session submenu, etc.) hardcodes text/highlight colors in its kvconfig,
    completely independent of the KDE color scheme. Write a user-local
    override (~/.config/Kvantum/Velox/) so those pick up the accent too,
    without needing root."""
    src = KVANTUM_SYSTEM_DIR / "Velox.kvconfig"
    if not src.exists():
        return
    r, g, b = int(hex_color[1:3], 16), int(hex_color[3:5], 16), int(hex_color[5:7], 16)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    bright_r, bright_g, bright_b = (round(c * 255) for c in colorsys.hsv_to_rgb(h, 0.92, 1.0))
    mid_r, mid_g, mid_b = (round(c * 255) for c in colorsys.hsv_to_rgb(h, 0.65, 0.65))
    bright_hex = "#{:02x}{:02x}{:02x}".format(bright_r, bright_g, bright_b)
    mid_hex = "#{:02x}{:02x}{:02x}".format(mid_r, mid_g, mid_b)

    text = src.read_text()
    text = text.replace("highlight.color=#8ab87a", f"highlight.color={bright_hex}")
    text = text.replace("inactive.highlight.color=#6d9960", f"inactive.highlight.color={mid_hex}")
    text = re.sub(r"^(\s*(?:text\.color|window\.text\.color|button\.text\.color|"
                  r"tooltip\.text\.color|text\.normal\.color|text\.press\.color|"
                  r"text\.focus\.color|text\.toggle\.color)=)white$",
                  rf"\g<1>{bright_hex}", text, flags=re.MULTILINE)

    KVANTUM_USER_DIR.mkdir(parents=True, exist_ok=True)
    (KVANTUM_USER_DIR / "Velox.kvconfig").write_text(text)

    svg_link = KVANTUM_USER_DIR / "Velox.svg"
    if not svg_link.exists():
        svg_target = (KVANTUM_SYSTEM_DIR / "Velox.svg").resolve()
        svg_link.symlink_to(svg_target)


QT_CT_ROLE_INDICES = {
    0: "bright",   # WindowText -- general widget/menu label text
    6: "bright",   # Text
    8: "bright",   # ButtonText
    12: "bright",  # Highlight -- was the stale green hover/selection color
    14: "bright",  # Link
    15: "bright",  # LinkVisited
    19: "bright",  # ToolTipText
}


def apply_qtct_palette(hex_color):
    """qt5ct/qt6ct (QT_QPA_PLATFORMTHEME=qt5ct) load a raw QPalette from
    their own colors/velox-dark.conf, bypassing both kdeglobals and Kvantum
    entirely -- this is what actually drives the desktop right-click menu
    and other plain-Qt-widget text."""
    r, g, b = int(hex_color[1:3], 16), int(hex_color[3:5], 16), int(hex_color[5:7], 16)
    h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
    br, bg, bb = (round(c * 255) for c in colorsys.hsv_to_rgb(h, 0.92, 1.0))
    bright_argb = "#ff{:02x}{:02x}{:02x}".format(br, bg, bb)

    for ct_dir in ("qt5ct", "qt6ct"):
        conf = Path.home() / f".config/{ct_dir}/colors/velox-dark.conf"
        if not conf.exists():
            continue
        text = conf.read_text()
        for state in ("active_colors", "inactive_colors"):
            m = re.search(rf"^{state}=(.*)$", text, re.MULTILINE)
            if not m:
                continue
            values = [v.strip() for v in m.group(1).split(",")]
            for idx in QT_CT_ROLE_INDICES:
                if idx < len(values):
                    values[idx] = bright_argb
            new_line = f"{state}=" + ", ".join(values)
            text = text[:m.start()] + new_line + text[m.end():]
        conf.write_text(text)


def restart_plasmashell():
    subprocess.run(["systemctl", "--user", "stop", "plasma-plasmashell.service"], check=True)
    subprocess.run(["sleep", "2"])


def colors_similar(hex_a, hex_b, threshold=40):
    """True if two hex colors are close enough to treat as unchanged --
    screenshot-based extraction has natural frame-to-frame jitter (cursor,
    compositor blur) that shouldn't trigger a restart."""
    a = tuple(int(hex_a[i:i + 2], 16) for i in (1, 3, 5))
    b = tuple(int(hex_b[i:i + 2], 16) for i in (1, 3, 5))
    return sum((x - y) ** 2 for x, y in zip(a, b)) ** 0.5 <= threshold


def main():
    if "--similar" in sys.argv[1:]:
        idx = sys.argv.index("--similar")
        hex_a, hex_b = sys.argv[idx + 1], sys.argv[idx + 2]
        sys.exit(0 if colors_similar(hex_a, hex_b) else 1)

    args = [a for a in sys.argv[1:] if a != "--extract-only"]
    extract_only = "--extract-only" in sys.argv[1:]

    image_path = Path(args[0]) if args else current_wallpaper_path()
    hex_color = extract_accent(image_path)

    if extract_only:
        print(hex_color)
        return

    print(f"wallpaper: {image_path}")
    print(f"accent color: {hex_color}")

    subprocess.run(["systemctl", "--user", "stop", "plasma-plasmashell.service"], check=True)
    apply_color(hex_color)
    apply_kdeglobals_selection(hex_color)
    apply_kvantum_theme(hex_color)
    apply_qtct_palette(hex_color)
    subprocess.run(["systemctl", "--user", "start", "plasma-plasmashell.service"], check=True)
    print("applied and restarted plasmashell")


if __name__ == "__main__":
    main()
