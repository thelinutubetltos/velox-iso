<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu xmlns="http://openbox.org/"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://openbox.org/ file:///usr/share/openbox/menu.xsd">

<menu id="root-menu" label="Velox">
  <item label="Terminal">
    <action name="Execute"><command>alacritty</command></action>
  </item>
  <item label="Install Velox">
    <action name="Execute"><command>calamares</command></action>
  </item>
  <separator/>
  <item label="Enable SSH">
    <action name="Execute"><command>alacritty -e bash -c "sudo systemctl start sshd; echo 'SSH started on port 22'; read"</command></action>
  </item>
  <separator/>
  <item label="Exit">
    <action name="Exit"/>
  </item>
</menu>

</openbox_menu>
